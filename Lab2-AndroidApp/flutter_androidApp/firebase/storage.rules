rules_version = '2';

// Cloud Storage rules for FAP Attendance (PRM393 Lab 3).
// Each lecturer may only read/write files under their own uid prefix:
//   reports/{uid}/...   <- matches FirebaseStorageService.uploadReport()
// Everything else is denied. Never use "allow read, write: if true".
service firebase.storage {
  match /b/{bucket}/o {

    match /reports/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('text/csv|application/pdf');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Default deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
